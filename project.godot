config_version=5

[application]
config/name="Tirta"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/handheld/orientation=1
window/stretch/mode="canvas_items"

[input]
move_left={"deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":65,"pressed":false)]}
move_right={"deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":68,"pressed":false)]}
jump={"deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":32,"pressed":false)]}
dash={"deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":4194325,"pressed":false)]}

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
